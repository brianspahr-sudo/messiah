export default {
  async fetch() {

    const calendarUrl =
      "https://outlook.office365.com/owa/calendar/d128306f4bd04c01bf3dc02fd4b6f16b@messiahlc.com/7774d258e9ae4d1495e41d821328770613475568593175685060/calendar.ics";

    const response = await fetch(calendarUrl);
    const ics = await response.text();

    const events = parseICS(ics);

    const now = new Date();

    const upcoming = events
      .filter(event => new Date(event.start) >= now)
      .sort((a, b) =>
        new Date(a.start) - new Date(b.start)
      )
      .slice(0, 15);

    return new Response(
      JSON.stringify(upcoming, null, 2),
      {
        headers: {
          "Content-Type": "application/json",
          "Access-Control-Allow-Origin": "*",
          "Cache-Control": "max-age=300"
        }
      }
    );
  }
};


function parseICS(text) {

  const events = [];

  const blocks = text.split("BEGIN:VEVENT");

  blocks.forEach(block => {

    if (!block.includes("END:VEVENT")) return;

    const getValue = (field) => {

      const match = block.match(
        new RegExp("^" + field + ".*:(.*)$", "m")
      );

      return match ? match[1].trim() : "";

    };


    const start = getValue("DTSTART");
    const end = getValue("DTEND");
    const summary = getValue("SUMMARY");
    const location = getValue("LOCATION");
    const description = getValue("DESCRIPTION");


    if (!start || !summary) return;


    events.push({

      title: cleanText(summary),

      start: formatDate(start),

      end: formatDate(end),

      location: cleanText(location),

      description: cleanText(description)

    });

  });


  return events;

}


function formatDate(value) {

  if (!value) return "";

  const year = value.substring(0,4);
  const month = value.substring(4,6);
  const day = value.substring(6,8);

  const hour = value.substring(9,11) || "00";
  const minute = value.substring(11,13) || "00";


  return `${year}-${month}-${day}T${hour}:${minute}:00`;

}


function cleanText(value) {

  return value
    .replace(/\\n/g, " ")
    .replace(/\\/g, "")
    .trim();

}
